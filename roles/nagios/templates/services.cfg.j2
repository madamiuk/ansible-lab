{% for host in groups['all'] %}
{% if host != inventory_hostname %}

define service {
    use                     generic-service
    host_name               {{ host }}
    service_description     PING
    check_command           check_ping!100.0,20%!500.0,60%
}

define service {
    use                     generic-service
    host_name               {{ host }}
    service_description     SSH
    check_command           check_ssh
}

{% if host in groups['wildfly'] %}
define service {
    use                     generic-service
    host_name               {{ host }}
    service_description     WildFly HTTP
    check_command           check_nrpe!check_wildfly_http
}
define service {
    use                     generic-service
    host_name               {{ host }}
    service_description     System Load
    check_command           check_nrpe!check_load
}
define service {
    use                     generic-service
    host_name               {{ host }}
    service_description     Root Disk
    check_command           check_nrpe!check_disk_root
}
define service {
    use                     generic-service
    host_name               {{ host }}
    service_description     Processes
    check_command           check_nrpe!check_procs
}
define service {
    use                     generic-service
    host_name               {{ host }}
    service_description     Memory
    check_command           check_nrpe!check_memory
}
{% endif %}


{% if host in groups['database'] %}
define service {
    use                     generic-service
    host_name               {{ host }}
    service_description     PostgreSQL
    check_command           check_tcp!5432
}
{% endif %}

{% if host in groups['http_servers'] %}
define service {
    use                     generic-service
    host_name               {{ host }}
    service_description     HTTP
    check_command           check_http
}
{% endif %}

{% if host in groups['tomcat'] %}
define service {
    use                     generic-service
    host_name               {{ host }}
    service_description     Tomcat Application
    check_command           check_http!-p 8080 -u /hello-tomcat/hello -e 200
}
{% endif %}

{% endif %}
{% endfor %}
