[Unit]
Description=Nextcloud cron.php job
After=network.target php-fpm.service
Requires=php-fpm.service

[Service]
Type=oneshot
User=nginx
Group=nginx
ExecCondition=/usr/bin/php -f {{ nextcloud_server_web_root }}/occ status -e
ExecStart=/usr/bin/php -f {{ nextcloud_server_web_root }}/cron.php
KillMode=process
