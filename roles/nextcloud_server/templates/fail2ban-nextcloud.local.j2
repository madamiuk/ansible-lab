[nextcloud]
enabled = true
backend = auto
port = 80,443
protocol = tcp
filter = nextcloud
logpath = {{ nextcloud_server_log_file }}
maxretry = {{ nextcloud_server_fail2ban_nextcloud_maxretry }}
bantime = {{ nextcloud_server_fail2ban_nextcloud_bantime }}
findtime = {{ nextcloud_server_fail2ban_nextcloud_findtime }}
banaction = firewallcmd-rich-rules
