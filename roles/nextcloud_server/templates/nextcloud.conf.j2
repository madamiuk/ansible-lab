server {
    listen 80;
    listen [::]:80;

    server_name {{ nextcloud_server_server_name }};

    location ^~ /.well-known/acme-challenge/ {
        root {{ nextcloud_server_acme_webroot }};
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name {{ nextcloud_server_server_name }};

    root {{ nextcloud_server_web_root }};
    index index.php index.html /index.php$request_uri;

    ssl_certificate /etc/letsencrypt/live/{{ nextcloud_server_server_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ nextcloud_server_server_name }}/privkey.pem;

    client_max_body_size 512M;
    fastcgi_buffers 64 4K;

    include /etc/nginx/mime.types;

    types {
        text/javascript mjs;
        application/wasm wasm;
    }

    location ~ \.php(?:$|/) {
        fastcgi_split_path_info ^(.+?\.php)(/.*)$;
        try_files $fastcgi_script_name =404;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS on;
        fastcgi_param modHeadersAvailable true;
        fastcgi_param front_controller_active true;

        fastcgi_pass unix:/run/php-fpm/www.sock;

        fastcgi_intercept_errors on;
        fastcgi_request_buffering off;
    }

    location ~ \.(?:css|js|mjs|svg|gif|ico|jpg|png|webp|wasm|tflite|map|ogg|flac|mp4|webm)$ {
        try_files $uri /index.php$request_uri;

        add_header Cache-Control "public, max-age=15778463";
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Permitted-Cross-Domain-Policies "none" always;
        add_header X-Robots-Tag "noindex, nofollow" always;

        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.php$request_uri;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
