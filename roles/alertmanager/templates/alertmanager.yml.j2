global:
  resolve_timeout: 5m

route:
  receiver: "default"
  group_by:
    - alertname
    - host
    - severity
  group_wait: 10s
  group_interval: 30s
  repeat_interval: 1h

  routes:
    - matchers:
        - severity="critical"
      receiver: "critical"

    - matchers:
        - severity="warning"
      receiver: "warning"

inhibit_rules:
  - source_matchers:
      - alertname="HighCPUCritical"
    target_matchers:
      - alertname="HighCPUWarning"
    equal:
      - host

  - source_matchers:
      - alertname="HighMemoryCritical"
    target_matchers:
      - alertname="HighMemoryWarning"
    equal:
      - host

  - source_matchers:
      - alertname="RootFilesystemCritical"
    target_matchers:
      - alertname="RootFilesystemWarning"
    equal:
      - host

  - source_matchers:
      - alertname="HighLoadCritical"
    target_matchers:
      - alertname="HighLoadWarning"
    equal:
      - host

receivers:
  - name: "default"

  - name: "warning"

  - name: "critical"
    webhook_configs:
      - url: "http://127.0.0.1:9087/alert"
        send_resolved: true
