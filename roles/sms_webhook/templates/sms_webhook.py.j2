#!/usr/bin/env python3

import json
import logging
from http.server import BaseHTTPRequestHandler, HTTPServer


BIND_ADDRESS = "{{ sms_webhook_bind_address }}"
PORT = {{ sms_webhook_port }}

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s"
)


class AlertHandler(BaseHTTPRequestHandler):

    def log_message(self, format, *args):
        return

    def do_GET(self):
        if self.path == "/health":
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"OK\n")
            return

        self.send_response(404)
        self.end_headers()

    def do_POST(self):
        if self.path != "/alert":
            self.send_response(404)
            self.end_headers()
            return

        try:
            content_length = int(self.headers.get("Content-Length", "0"))
            body = self.rfile.read(content_length)

            payload = json.loads(body)

            status = payload.get("status", "unknown")
            alerts = payload.get("alerts", [])

            logging.info(
                "Received Alertmanager webhook: status=%s alerts=%d",
                status,
                len(alerts),
            )

            for alert in alerts:
                labels = alert.get("labels", {})
                annotations = alert.get("annotations", {})

                logging.info(
                    "ALERT status=%s alertname=%s host=%s severity=%s summary=%s",
                    status,
                    labels.get("alertname", "unknown"),
                    labels.get("host", "unknown"),
                    labels.get("severity", "unknown"),
                    annotations.get("summary", ""),
                )

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()

            self.wfile.write(
                json.dumps({"status": "ok"}).encode()
            )

        except Exception:
            logging.exception("Failed processing Alertmanager webhook")

            self.send_response(500)
            self.end_headers()


if __name__ == "__main__":
    server = HTTPServer(
        (BIND_ADDRESS, PORT),
        AlertHandler
    )

    logging.info(
        "SMS webhook listening on %s:%d",
        BIND_ADDRESS,
        PORT,
    )

    server.serve_forever()
