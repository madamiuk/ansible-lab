# Managed by Ansible

define host {
    use                     linux-server
    host_name               oci-ansible03
    alias                   OCI PostgreSQL Database Server
    address                 {{ nagios_server_postgresql_host }}
}

define service {
    use                     generic-service
    host_name               oci-ansible03
    service_description     PING
    check_command           check_ping!100.0,20%!500.0,60%
}

define service {
    use                     generic-service
    host_name               oci-ansible03
    service_description     SSH
    check_command           check_ssh
}

define service {
    use                     generic-service
    host_name               oci-ansible03
    service_description     Load
    check_command           check_nrpe!check_load
}

define service {
    use                     generic-service
    host_name               oci-ansible03
    service_description     Root Disk
    check_command           check_nrpe!check_root_disk
}

define service {
    use                     generic-service
    host_name               oci-ansible03
    service_description     Users
    check_command           check_nrpe!check_users
}

define service {
    use                     generic-service
    host_name               oci-ansible03
    service_description     Processes
    check_command           check_nrpe!check_total_procs
}

define service {
    use                     generic-service
    host_name               oci-ansible03
    service_description     PostgreSQL JobTracker
    check_command           check_pgsql_jobtracker
}
