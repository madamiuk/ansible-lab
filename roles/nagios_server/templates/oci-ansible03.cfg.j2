# Managed by Ansible

define host {
    use                     linux-server
    host_name               oci-ansible03
    alias                   OCI PostgreSQL Database Server
    address                 {{ nagios_server_postgresql_host }}
}

{% for service in nagios_server_common_services %}
define service {
    use                     generic-service
    host_name               oci-ansible03
    service_description     {{ service.description }}
    check_command           {{ service.command }}
}
{% endfor %}

define service {
    use                     generic-service
    host_name               oci-ansible03
    service_description     PostgreSQL Process
    check_command           check_nrpe!check_postgresql_process
}

define service {
    use                     generic-service
    host_name               oci-ansible03
    service_description     PostgreSQL JobTracker
    check_command           check_pgsql_jobtracker
}

define service {
    use                     generic-service
    host_name               oci-ansible03
    service_description     PostgreSQL Connections
    check_command           check_pgsql_connections
}

define service {
    use                     generic-service
    host_name               oci-ansible03
    service_description     PostgreSQL Database Size
    check_command           check_pgsql_database_size
}
