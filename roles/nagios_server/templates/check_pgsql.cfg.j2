# Managed by Ansible

define command {
    command_name    check_pgsql_jobtracker
    command_line    $USER1$/check_pgsql --extra-opts=pgsql@/etc/nagios/check_pgsql.ini -H $HOSTADDRESS$ -P {{ nagios_server_postgresql_port }} -w {{ nagios_server_service_thresholds.postgresql.connection.warning_seconds }} -c {{ nagios_server_service_thresholds.postgresql.connection.critical_seconds }}
}

define command {
    command_name    check_pgsql_connections
    command_line    $USER1$/check_pgsql --extra-opts=pgsql@/etc/nagios/check_pgsql.ini -H $HOSTADDRESS$ -P {{ nagios_server_postgresql_port }} -q "SELECT count(*) FROM pg_stat_activity WHERE datname = '{{ nagios_server_postgresql_database }}'" -W {{ nagios_server_service_thresholds.postgresql.connections.warning }} -C {{ nagios_server_service_thresholds.postgresql.connections.critical }}
}

define command {
    command_name    check_pgsql_database_size
    command_line    $USER1$/check_pgsql --extra-opts=pgsql@/etc/nagios/check_pgsql.ini -H $HOSTADDRESS$ -P {{ nagios_server_postgresql_port }} -q "SELECT pg_database_size('{{ nagios_server_postgresql_database }}') / 1024 / 1024" -W {{ nagios_server_service_thresholds.postgresql.database_size_mb.warning }} -C {{ nagios_server_service_thresholds.postgresql.database_size_mb.critical }}
}
