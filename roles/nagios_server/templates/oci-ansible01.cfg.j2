# Managed by Ansible

define host {
    use                     linux-server
    host_name               oci-ansible01
    alias                   OCI Ansible Application Server
    address                 {{ nagios_server_application_host }}
}

{% for service in nagios_server_common_services %}
define service {
    use                     generic-service
    host_name               oci-ansible01
    service_description     {{ service.description }}
    check_command           {{ service.command }}
}
{% endfor %}

define service {
    use                     generic-service
    host_name               oci-ansible01
    service_description     WildFly HTTP
    check_command           check_http!-p 8080 -u /
}
