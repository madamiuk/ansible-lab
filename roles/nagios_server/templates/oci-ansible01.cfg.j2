# Managed by Ansible

define host {
    use                     linux-server
    host_name               oci-ansible01
    alias                   OCI Ansible Application Server
    address                 10.10.1.37
}

define service {
    use                     generic-service
    host_name               oci-ansible01
    service_description     PING
    check_command           check_ping!100.0,20%!500.0,60%
}

define service {
    use                     generic-service
    host_name               oci-ansible01
    service_description     SSH
    check_command           check_ssh
}

define service {
    use                     generic-service
    host_name               oci-ansible01
    service_description     Load
    check_command           check_nrpe!check_load
}

define service {
    use                     generic-service
    host_name               oci-ansible01
    service_description     Root Disk
    check_command           check_nrpe!check_root_disk
}

define service {
    use                     generic-service
    host_name               oci-ansible01
    service_description     Users
    check_command           check_nrpe!check_users
}

define service {
    use                     generic-service
    host_name               oci-ansible01
    service_description     Processes
    check_command           check_nrpe!check_total_procs
}

define service {
    use                     generic-service
    host_name               oci-ansible01
    service_description     WildFly HTTP
    check_command           check_http!-p 8080 -u /
}
