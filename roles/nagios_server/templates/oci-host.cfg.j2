# Managed by Ansible

define host {
    use                     linux-server
    host_name               {{ monitored_host }}
    alias                   {{ monitored_host }}
    address                 {{ hostvars[monitored_host].private_ip }}
}

{% for service in nagios_server_common_services %}
define service {
    use                     generic-service
    host_name               {{ monitored_host }}
    service_description     {{ service.description }}
    check_command           {{ service.command }}
}
{% endfor %}

{% for group_name, services in nagios_server_group_services.items() %}
{% if monitored_host in (groups[group_name] | default([])) %}
{% for service in services %}
define service {
    use                     generic-service
    host_name               {{ monitored_host }}
    service_description     {{ service.description }}
    check_command           {{ service.command }}
}
{% endfor %}
{% endif %}
{% endfor %}
