# Plik wygenerowany przez Ansible
# Host: {{ inventory_hostname }}

{% for service in monitored_services %}
{% if service.enabled %}
[{{ service.name }}]
port={{ service.port }}
critical={{ service.critical }}
description={{ service.description | default('brak opisu') }}
owner={{ service.owner | mandatory | upper }}
{% if service.critical %}
alert_level=critical
{% else %}
alert_level=normal
{% endif %}

{% endif %}
{% endfor %}
