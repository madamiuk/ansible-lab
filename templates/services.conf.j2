# Plik wygenerowany przez Ansible
# Host: {{ inventory_hostname }}
{% import 'service_macros.j2' as service_macros %}

{% for service in monitored_services %}
{% if service.enabled %}
{{ service_macros.render_service(service) }}
{% endif %}
{% endfor %}

# Lista wszystkich nazw usług
services={{ monitored_services
  | selectattr('enabled', 'equalto', true)
  | map(attribute='name')
  | join(',')
}}

# Lista właścicieli
owners={{ monitored_services
  | map(attribute='owner')
  | select('defined')
  | unique
  | join(',')
  }}

# Lista aktywnych usług krytycznych
critical_services={{ monitored_services
  | selectattr('enabled', 'equalto', true)
  | selectattr('critical', 'equalto', true)
  | map(attribute='name')
  | join(',')
}}

{% set active_services = monitored_services
  | selectattr('enabled', 'equalto', true)
  | list
%}

{% set active_critical_services = active_services
  | selectattr('critical', 'equalto', true)
  | list
%}

{% include 'services_summary.j2' %}
